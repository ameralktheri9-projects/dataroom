# Copy to .env.local and fill in. Never commit real values (NFR-04): set them in Vercel → Settings → Environment Variables.

# Neon pooled connection string (Neon console → Connect → "Pooled connection").
# For a quick local start without a database server: DATABASE_URL=pglite:./.data/pglite
DATABASE_URL=postgres://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Optional: direct (non-pooled) string for migrations. Neon's Vercel integration sets this automatically.
DATABASE_URL_UNPOOLED=

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=
APP_URL=http://localhost:3000

# File storage: "local" (development only) or "s3" (AWS S3 Frankfurt or Cloudflare R2)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./.data/uploads
S3_BUCKET=
S3_REGION=eu-central-1
# Cloudflare R2 only: https://<account-id>.r2.cloudflarestorage.com  (and S3_REGION=auto)
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: "console" writes to the terminal and .data/outbox/; "resend" sends for real
EMAIL_DRIVER=console
RESEND_API_KEY=
EMAIL_FROM=Data Room <dataroom@example.com>
